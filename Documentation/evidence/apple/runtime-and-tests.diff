+   let type: String
+   let text: String?
+   let bytes: [UInt8]?
+   let segments: [FixtureSegment]?
+   let options: FixtureOptions
+   let expected: FixtureExpected
+}
+private struct FixtureOptions: Decodable {
+   let version: Int?
+   let minVersion: Int?
+   let maxVersion: Int?
+   let maskPattern: Int?
+   let errorCorrectionLevel: ErrorCorrectionLevel?
+   let mode: QRMode?
+   let optimizeSegments: Bool?
+   let maxSymbols: Int?
